{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Detection",
  "type": "object",
  "required": [
    "detectionId",
    "eventId",
    "sensorId",
    "severity",
    "anomalyType",
    "message",
    "timestamp"
  ],
  "properties": {
    "detectionId": {
      "type": "string",
      "format": "uuid"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "sensorId": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "anomalyType": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}