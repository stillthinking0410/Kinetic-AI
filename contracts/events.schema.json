{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "type": "object",
  "required": [
    "eventId",
    "sensorId",
    "value",
    "timestamp"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "sensorId": {
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}