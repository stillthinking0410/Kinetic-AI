{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DetectionDeadLetter",
  "type": "object",
  "required": [
    "originalDetection",
    "errorMessage",
    "failedAt",
    "sourceTopic",
    "retryCount"
  ],
  "properties": {
    "originalDetection": {
      "$ref": "./detection.schema.json"
    },
    "errorMessage": {
      "type": "string"
    },
    "failedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceTopic": {
      "type": "string"
    },
    "retryCount": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}